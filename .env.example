NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API (the Next.js shop)
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://bdshop:bdshop_dev_password@localhost:5432/bdshop?schema=public
# true behind Nginx / a load balancer
TRUST_PROXY=false
# lax (default) or none — use none when the shop and API are on unrelated domains
COOKIE_SAMESITE=lax
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# First owner account (used only by `npx prisma db seed`)
SEED_ADMIN_EMAIL=admin@bdshop.com
SEED_ADMIN_PASSWORD=
